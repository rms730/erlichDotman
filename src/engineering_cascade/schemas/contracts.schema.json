        "objective": {
          "type": "string",
          "minLength": 1
        },
        "complexity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "ambiguity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "risk": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "signals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "security",
              "irreversible",
              "large_blast_radius",
              "distributed",
              "unfamiliar",
              "contradictory",
              "cross_repository",
              "production_critical",
              "unclear_root_cause"
            ]
          }
        },
        "mechanical": {
          "type": "boolean"
        },
        "deterministic": {
          "type": "boolean"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_commands": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1

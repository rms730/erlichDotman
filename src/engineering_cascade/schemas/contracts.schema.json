        "task_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"
        },
        "category": {
          "enum": [
            "tiny_bug",
            "feature",
            "refactor",
            "api_integration",
            "ui_change",
            "migration",
            "flaky_test",
            "dependency_upgrade",
            "unfamiliar_repository",
            "multi_file_bug",
            "architecture",
            "security",
            "documentation",
            "review",
            "performance"
          ]
        },
        "stage": {
          "enum": [
            "understanding",
            "research",
            "architecture",
            "planning",
            "implementation",
            "validation",
            "debugging",
            "review",
            "documentation",
            "escalation"
          ]
